{
  "name": "@sip/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build && tsc -p tsconfig.seed.json",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test prisma --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts --exclude 'test/**/*.integration-spec.ts'",
    "test:integration": "vitest run --config vitest.config.mts test/api.integration-spec.ts",
    "test:tenant-isolation": "vitest run --config vitest.config.mts test/tenant-isolation.integration-spec.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:provision:runtime": "tsx src/scripts/provision-runtime-role.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:bootstrap:staging": "tsx prisma/seed.ts --staging",
    "import:excel": "tsx src/modules/imports/excel-importer.cli.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.5.0",
    "@prisma/client": "6.19.3",
    "@sip/shared": "workspace:*",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "cookie-parser": "1.4.7",
    "dotenv": "17.3.1",
    "exceljs": "4.4.0",
    "helmet": "8.1.0",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.3",
    "@sip/eslint-config": "workspace:*",
    "@sip/typescript-config": "workspace:*",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.10.13",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.2",
    "supertest": "7.2.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
