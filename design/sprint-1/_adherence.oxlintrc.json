{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/controls/**",
              "components/copilot/**",
              "components/core/**",
              "components/data/**",
              "components/overlay/**",
              "components/sales/**",
              "product_screens/**",
              "ui_kits/command-platform/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|uppercase|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, icon, uppercase, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|brand|positive|warning|risk|critical|outline)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'brand' | 'positive' | 'warning' | 'risk' | 'critical' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconAfter|full|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconAfter, full, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|outline|ghost|danger|onDark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'outline' | 'ghost' | 'danger' | 'onDark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg|icon)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg' | 'icon'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|pad|children|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, pad, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|inverse|risk|sunken)$/]",
        "message": "<Card> tone must be one of 'default' | 'inverse' | 'risk' | 'sunken'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Command'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|group|hint|key|ref|className|style|children)$/]",
        "message": "<Command> doesn't accept that prop. Declared props: id, label, group, hint."
      },
      {
        "selector": "JSXOpeningElement[name.name='CopilotInsightItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|opportunityId|key|ref|className|style|children)$/]",
        "message": "<CopilotInsightItem> doesn't accept that prop. Declared props: label, value, opportunityId."
      },
      {
        "selector": "JSXOpeningElement[name.name='CopilotMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|text|key|ref|className|style|children)$/]",
        "message": "<CopilotMessage> doesn't accept that prop. Declared props: role, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='CopilotMessage'] > JSXAttribute[name.name='role'] > Literal[value!=/^(?:user|assistant)$/]",
        "message": "<CopilotMessage> role must be one of 'user' | 'assistant'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataQualityCounts'] > JSXAttribute > JSXIdentifier[name!=/^(?:ready|warnings|invalid|duplicates|key|ref|className|style|children)$/]",
        "message": "<DataQualityCounts> doesn't accept that prop. Declared props: ready, warnings, invalid, duplicates."
      },
      {
        "selector": "JSXOpeningElement[name.name='FilterChip'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|count|key|ref|className|style|children)$/]",
        "message": "<FilterChip> doesn't accept that prop. Declared props: id, label, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='ForecastConfidence'] > JSXAttribute > JSXIdentifier[name!=/^(?:sellerCategory|confidence|rationale|key|ref|className|style|children)$/]",
        "message": "<ForecastConfidence> doesn't accept that prop. Declared props: sellerCategory, confidence, rationale."
      },
      {
        "selector": "JSXOpeningElement[name.name='ForecastConfidence'] > JSXAttribute[name.name='sellerCategory'] > Literal[value!=/^(?:PIPELINE|BEST_CASE|COMMIT|CLOSED|OMITTED)$/]",
        "message": "<ForecastConfidence> sellerCategory must be one of 'PIPELINE' | 'BEST_CASE' | 'COMMIT' | 'CLOSED' | 'OMITTED'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ForecastMovementItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|delta|reason|opportunityId|key|ref|className|style|children)$/]",
        "message": "<ForecastMovementItem> doesn't accept that prop. Declared props: label, delta, reason, opportunityId."
      },
      {
        "selector": "JSXOpeningElement[name.name='FunnelStage'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|token|amount|count|widthPct|atRisk|atRiskAmount|avgDaysInStage|likelyToSlip|conversion|probability|avgAmount|currency|selected|onSelect|key|ref|className|style|children)$/]",
        "message": "<FunnelStage> doesn't accept that prop. Declared props: name, token, amount, count, widthPct, atRisk, atRiskAmount, avgDaysInStage, likelyToSlip, conversion, probability, avgAmount, currency, selected, onSelect."
      },
      {
        "selector": "JSXOpeningElement[name.name='FunnelStage'] > JSXAttribute[name.name='token'] > Literal[value!=/^(?:discovery|qualified|proposal|commit|backlog|billed)$/]",
        "message": "<FunnelStage> token must be one of 'discovery' | 'qualified' | 'proposal' | 'commit' | 'backlog' | 'billed'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GuidedTask'] > JSXAttribute > JSXIdentifier[name!=/^(?:step|total|title|why|children|primaryLabel|onPrimary|onSkip|onBack|key|ref|className|style|children)$/]",
        "message": "<GuidedTask> doesn't accept that prop. Declared props: step, total, title, why, children, primaryLabel, onPrimary, onSkip, onBack."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|label|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImportMappingRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:source|target|confidence|key|ref|className|style|children)$/]",
        "message": "<ImportMappingRow> doesn't accept that prop. Declared props: source, target, confidence."
      },
      {
        "selector": "JSXOpeningElement[name.name='Input'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|hint|error|icon|borderless|key|ref|className|style|children)$/]",
        "message": "<Input> doesn't accept that prop. Declared props: label, hint, error, icon, borderless."
      },
      {
        "selector": "JSXOpeningElement[name.name='NextBestAction'] > JSXAttribute > JSXIdentifier[name!=/^(?:customer|amount|currency|category|risk|suggestion|severity|primaryLabel|onPrimary|onOpen|key|ref|className|style|children)$/]",
        "message": "<NextBestAction> doesn't accept that prop. Declared props: customer, amount, currency, category, risk, suggestion, severity, primaryLabel, onPrimary, onOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='NextBestAction'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:WARNING|HIGH|CRITICAL)$/]",
        "message": "<NextBestAction> severity must be one of 'WARNING' | 'HIGH' | 'CRITICAL'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DrawerOpportunity'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|customer|amount|currency|stage|forecastCategory|seller|partner|brand|closeDate|billingDate|margin|health|alerts|daysInStage|stageBenchmarkDays|nextStep|lastActivity|evidence|nextAction|stageHistory|key|ref|className|style|children)$/]",
        "message": "<DrawerOpportunity> doesn't accept that prop. Declared props: title, customer, amount, currency, stage, forecastCategory, seller, partner, brand, closeDate, billingDate, margin, health, alerts, daysInStage, stageBenchmarkDays, nextStep, lastActivity, evidence, nextAction, stageHistory."
      },
      {
        "selector": "JSXOpeningElement[name.name='HealthFactor'] > JSXAttribute > JSXIdentifier[name!=/^(?:code|impact|message|key|ref|className|style|children)$/]",
        "message": "<HealthFactor> doesn't accept that prop. Declared props: code, impact, message."
      },
      {
        "selector": "JSXOpeningElement[name.name='PeriodSelector'] > JSXAttribute > JSXIdentifier[name!=/^(?:periods|value|onChange|comparison|key|ref|className|style|children)$/]",
        "message": "<PeriodSelector> doesn't accept that prop. Declared props: periods, value, onChange, comparison."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuotaGapDriver'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|amount|key|ref|className|style|children)$/]",
        "message": "<QuotaGapDriver> doesn't accept that prop. Declared props: label, amount."
      },
      {
        "selector": "JSXOpeningElement[name.name='QuotaProgress'] > JSXAttribute > JSXIdentifier[name!=/^(?:quota|billed|forecast|currency|label|compact|key|ref|className|style|children)$/]",
        "message": "<QuotaProgress> doesn't accept that prop. Declared props: quota, billed, forecast, currency, label, compact."
      },
      {
        "selector": "JSXOpeningElement[name.name='RevenueKPI'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|currency|format|detail|delta|deltaLabel|icon|tone|hero|key|ref|className|style|children)$/]",
        "message": "<RevenueKPI> doesn't accept that prop. Declared props: label, value, currency, format, detail, delta, deltaLabel, icon, tone, hero."
      },
      {
        "selector": "JSXOpeningElement[name.name='RevenueKPI'] > JSXAttribute[name.name='format'] > Literal[value!=/^(?:currency|percent|multiple|raw)$/]",
        "message": "<RevenueKPI> format must be one of 'currency' | 'percent' | 'multiple' | 'raw'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RevenueKPI'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|positive|warning|risk)$/]",
        "message": "<RevenueKPI> tone must be one of 'default' | 'positive' | 'warning' | 'risk'."
      },
      {
        "selector": "JSXOpeningElement[name.name='RiskBadge'] > JSXAttribute > JSXIdentifier[name!=/^(?:severity|label|code|key|ref|className|style|children)$/]",
        "message": "<RiskBadge> doesn't accept that prop. Declared props: severity, label, code."
      },
      {
        "selector": "JSXOpeningElement[name.name='RiskBadge'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:INFO|WARNING|HIGH|CRITICAL)$/]",
        "message": "<RiskBadge> severity must be one of 'INFO' | 'WARNING' | 'HIGH' | 'CRITICAL'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SalesFunnel'] > JSXAttribute > JSXIdentifier[name!=/^(?:stages|currency|selectedStage|onSelectStage|renderDetail|key|ref|className|style|children)$/]",
        "message": "<SalesFunnel> doesn't accept that prop. Declared props: stages, currency, selectedStage, onSelectStage, renderDetail."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SellerPerformanceRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:seller|opportunities|pipeline|commit|quota|key|ref|className|style|children)$/]",
        "message": "<SellerPerformanceRow> doesn't accept that prop. Declared props: seller, opportunities, pipeline, commit, quota."
      },
      {
        "selector": "JSXOpeningElement[name.name='StageVelocity'] > JSXAttribute > JSXIdentifier[name!=/^(?:stage|daysInStage|benchmarkDays|key|ref|className|style|children)$/]",
        "message": "<StageVelocity> doesn't accept that prop. Declared props: stage, daysInStage, benchmarkDays."
      }
    ]
  },
